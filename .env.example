# Anthropic API キー (https://console.anthropic.com/ で取得)
ANTHROPIC_API_KEY=sk-ant-...

# Asana MCP サーバの認証トークン (Asana の OAuth アクセストークン)
# 取得方法は README の「Asana MCP トークンの取得」を参照
ASANA_MCP_TOKEN=

# 任意: Asana MCP サーバの URL (通常は変更不要)
# ASANA_MCP_URL=https://mcp.asana.com/sse

# 任意: 使用モデル (既定: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# 任意: ポート番号 (既定: 3000)
# PORT=3000

# ===== 必須 =====

# Anthropic API キー (https://console.anthropic.com/ で取得)
ANTHROPIC_API_KEY=sk-ant-...

# Asana 開発者コンソールで作成した「MCPアプリ」のクライアント情報
# (作成手順は SETUP.md を参照。作成後 `npm run auth` で連携する)
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# ===== 任意 =====

# Asana MCP サーバの URL (通常は変更不要)
# ASANA_MCP_URL=https://mcp.asana.com/v2/mcp

# OAuth コールバックのポート / リダイレクト URI
# (変更する場合は Asana アプリ側のリダイレクト URL 設定も合わせる)
# ASANA_OAUTH_CALLBACK_PORT=8787
# ASANA_OAUTH_REDIRECT_URI=http://localhost:8787/oauth/callback

# アクセストークンを直接指定する場合(npm run auth を使わない手動運用向け)
# ASANA_MCP_TOKEN=

# 使用モデル (既定: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# ポート番号 (既定: 3000)
# PORT=3000
